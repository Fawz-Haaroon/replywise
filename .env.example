# Choose exactly one provider. "offline" requires no network or credentials.
LLM_PROVIDER=offline

# Local OSS inference through Ollama.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# Optional free-tier cloud providers. Leave blank unless that provider is selected.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

LLM_REQUEST_TIMEOUT_SECONDS=60